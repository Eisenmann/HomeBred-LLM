<?xml version="1.0" encoding="utf-8"?>
<!-- CI-only NuGet config: the repo's HomeBred-LLM/nuget.config references a
     local Windows folder that doesn't exist on GitHub runners. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
