<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless UI smoke test: boots the real app (DI, views, view models) without a display,
       drives the main flows and saves a PNG per screen. See AGENTS.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeBred-LLM\HomeBred-LLM.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.0" />
    <!-- Headless Skia rendering on Linux needs these natives; Windows/macOS ship their own. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.3" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

</Project>
