+#pragma once
+
+#include "ggml.h"
+
+struct llama_model;
+
+// Internal view of one cached layer, used by the graph builder.
+struct hbec_layer_view {
+    ggml_tensor * slot_up      = nullptr;
+    ggml_tensor * slot_gate    = nullptr;
+    ggml_tensor * slot_down    = nullptr;
