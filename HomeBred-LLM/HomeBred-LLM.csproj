<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>HomeBred-LLM</AssemblyName>
    <RootNamespace>HomebredLLM</RootNamespace>
    <!-- Suppress CA1416 platform-compatibility warnings for guarded platform calls -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inference engine — ONNX Runtime GenAI for running LLM models in ONNX format.
         The DirectML package provides GPU acceleration on Windows via DirectX 12.
         Models are loaded from a directory containing model.onnx, config.json,
         and tokenizer files (produced by HuggingFace's optimum-export pipeline). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.14.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" Version="0.14.1" />

    <!-- GGUF inference (v2/v3) — LLamaSharp is the managed binding to llama.cpp.
         It needs exactly one native backend package alongside it, matching the
         machine this ships on. Swap the line below for the right one:
           LLamaSharp.Backend.Cpu     - no GPU, any OS (safest default)
           LLamaSharp.Backend.Cuda12  - NVIDIA GPUs, Windows/Linux
           LLamaSharp.Backend.Vulkan  - AMD/Intel/NVIDIA GPUs via Vulkan
           LLamaSharp.Backend.Metal   - Apple Silicon
         Only one backend package should be referenced at a time.
         Bumped 0.21.0 -> 0.27.0 to get qwen3 architecture support in the
         bundled llama.cpp native build (0.21.0 rejects qwen3 models with
         "unknown model architecture: 'qwen3'"). -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />

    <!-- Database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- DI + Hosting -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Transitive pins to patched versions (see NU1903 advisories on the unpinned versions).
         SQLitePCLRaw.lib.e_sqlite3 has no patched release yet (GHSA-2m69-gcr7-jv3q lists no
         fixed version as of 2.1.11) so it is left unpinned. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />

    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3"
                      Condition="'$(Configuration)' == 'Debug'" />

    <!-- Charts (Avalonia backend) -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0-rc4" />

    <!-- Windows PerformanceCounter (guarded by RuntimeInformation, needed for net8.0 TFM) -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

</Project>