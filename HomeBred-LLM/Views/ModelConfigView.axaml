<UserControl x:Class="HomebredLLM.Views.ModelConfigView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HomebredLLM.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="680">
            <TextBlock Classes="section-header">
                <Run Text="Configure — " />
                <Run Text="{Binding Model.Name, FallbackValue='Model'}" />
            </TextBlock>

            <Border Classes="card">
                <StackPanel>
                    <!-- Context size -->
                    <TextBlock Text="Context Size (tokens)" Classes="label" />
                    <Grid ColumnDefinitions="*,60" Margin="0,0,0,12">
                        <Slider Grid.Column="0"
                                Minimum="512" Maximum="131072"
                                Value="{Binding Config.ContextSize, Mode=TwoWay}"
                                TickFrequency="512"
                                VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Config.ContextSize}" />
                    </Grid>

                    <!-- Temperature -->
                    <TextBlock Text="Temperature" Classes="label" />
                    <Grid ColumnDefinitions="*,60" Margin="0,0,0,12">
                        <Slider Grid.Column="0"
                                Minimum="0" Maximum="2" TickFrequency="0.05"
                                Value="{Binding Config.Temperature, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Config.Temperature, StringFormat='{}{0:F2}'}" />
                    </Grid>

                    <!-- Top P -->
                    <TextBlock Text="Top P" Classes="label" />
                    <Grid ColumnDefinitions="*,60" Margin="0,0,0,12">
                        <Slider Grid.Column="0"
                                Minimum="0" Maximum="1" TickFrequency="0.05"
                                Value="{Binding Config.TopP, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Config.TopP, StringFormat='{}{0:F2}'}" />
                    </Grid>

                    <!-- Top K -->
                    <TextBlock Text="Top K" Classes="label" />
                    <TextBox Text="{Binding Config.TopK}" Margin="0,0,0,12" />

                    <!-- Repeat Penalty -->
                    <TextBlock Text="Repeat Penalty" Classes="label" />
                    <Grid ColumnDefinitions="*,60" Margin="0,0,0,12">
                        <Slider Grid.Column="0"
                                Minimum="1" Maximum="2" TickFrequency="0.05"
                                Value="{Binding Config.RepeatPenalty, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Config.RepeatPenalty, StringFormat='{}{0:F2}'}" />
                    </Grid>

                    <!-- GPU Layers -->
                    <TextBlock Text="GPU Layer Count  (−1 = all on GPU)" Classes="label" />
                    <TextBox Text="{Binding Config.GpuLayerCount}" Margin="0,0,0,12" />

                    <!-- Threads -->
                    <TextBlock Text="CPU Threads" Classes="label" />
                    <TextBox Text="{Binding Config.ThreadCount}" Margin="0,0,0,12" />

                    <!-- Batch Size -->
                    <TextBlock Text="Batch Size" Classes="label" />
                    <TextBox Text="{Binding Config.BatchSize}" Margin="0,0,0,12" />

                    <!-- Max Tokens -->
                    <TextBlock Text="Max Output Tokens" Classes="label" />
                    <TextBox Text="{Binding Config.MaxTokens}" Margin="0,0,0,12" />

                    <!-- System Prompt -->
                    <TextBlock Text="System Prompt" Classes="label" />
                    <TextBox Text="{Binding Config.SystemPrompt}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             Margin="0,0,0,16"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <!-- Local API endpoint -->
                    <CheckBox Content="Enable local API endpoint (OpenAI-compatible)"
                              IsChecked="{Binding ApiServerEnabled, Mode=TwoWay}"
                              Margin="0,0,0,8" />
                    <StackPanel IsVisible="{Binding ApiServerEnabled}" Margin="0,0,0,16">
                        <TextBlock Text="Port" Classes="label" />
                        <TextBox Text="{Binding Config.ApiPort}" Margin="0,0,0,6" />
                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                            <Run Text="Bound to 127.0.0.1 only. Chat: " />
                            <Run Text="{Binding Config.ApiPort, StringFormat='http://127.0.0.1:{0}/v1/chat/completions'}"
                                 FontFamily="Consolas,monospace" />
                        </TextBlock>
                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap">
                            <Run Text="Embeddings: " />
                            <Run Text="{Binding Config.ApiPort, StringFormat='http://127.0.0.1:{0}/v1/embeddings'}"
                                 FontFamily="Consolas,monospace" />
                        </TextBlock>
                    </StackPanel>

                    <!-- LoRA adapters -->
                    <TextBlock Text="LoRA Adapters" Classes="label" Margin="0,4,0,2" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Attach pre-trained GGUF LoRA adapters. Applied when the model starts — Stop and Start the model for changes to take effect." />

                    <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,72,Auto,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBox Text="{Binding Name}" Watermark="Adapter name" />
                                            <TextBlock Text="{Binding FilePath}" Classes="muted"
                                                       FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="Scale" Classes="muted" FontSize="10" />
                                            <TextBox Text="{Binding Scale, StringFormat='{}{0:F2}'}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Content="On"
                                                  IsChecked="{Binding Enabled}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Grid.Column="3" Content="🗑" Classes="ghost"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveAdapterCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="＋ Add adapter…"
                            Classes="ghost"
                            Click="AddAdapter_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4" />
                    <TextBlock Text="{Binding AdapterError}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />


                </StackPanel>
            </Border>
            <!-- ── Memory tiers (GGUF) ─────────────────────────────────── -->
            <Border Classes="card" Margin="0,12,0,0" IsVisible="{Binding IsGguf}">
                <StackPanel>
                    <TextBlock Text="Memory tiers" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Places weights across VRAM, RAM and disk within these budgets. For MoE models the RAM tier keeps the experts routing actually uses. VRAM changes apply at the next start; the RAM tier re-targets live." />
                    <TextBlock Text="{Binding HardwareNote}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <CheckBox Content="Tiered placement (off = use GPU Layer Count only)"
                              IsChecked="{Binding TieredMode}" Margin="0,0,0,10" />

                    <StackPanel IsVisible="{Binding TieredMode}">
                        <Grid ColumnDefinitions="Auto,*,64" Margin="0,0,0,8">
                            <CheckBox Grid.Column="0" Content="Auto VRAM" IsChecked="{Binding AutoVram}" Width="110" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding VramTotalGb}" Value="{Binding VramBudgetGb}"
                                    TickFrequency="0.5" IsSnapToTickEnabled="True" IsEnabled="{Binding !AutoVram}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="2" Text="{Binding VramBudgetGb}" IsEnabled="{Binding !AutoVram}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,64" Margin="0,0,0,10">
                            <CheckBox Grid.Column="0" Content="Auto RAM" IsChecked="{Binding AutoRam}" Width="110" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding RamTotalGb}" Value="{Binding RamBudgetGb}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding !AutoRam}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="2" Text="{Binding RamBudgetGb}" IsEnabled="{Binding !AutoRam}" />
                        </Grid>
                        <TextBlock Classes="muted" Margin="0,-6,0,10" Text="Budgets in GB. Auto = free VRAM − 0.75 GB, available RAM − 4 GB." />

                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox Content="Allow disk tier" IsChecked="{Binding AllowDiskTier}" Margin="0,0,16,0"
                                      ToolTip.Tip="Weights that fit neither VRAM nor the RAM budget stay memory-mapped and are read from disk on demand." />
                            <CheckBox Content="Lock warm tier in RAM" IsChecked="{Binding LockWarmTier}" Margin="0,0,16,0"
                                      ToolTip.Tip="Pins warm-tier pages (mlock / VirtualLock) so memory pressure can't evict them. May need a higher memlock limit." />
                            <CheckBox Content="KV cache on GPU" IsChecked="{Binding KvOnGpu}" Margin="0,0,16,0" />
                            <CheckBox Content="Flash attention" IsChecked="{Binding FlashAttention}" />
                        </WrapPanel>

                        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="KV cache type" Classes="label" />
                                <ComboBox ItemsSource="{Binding KvOptions}" SelectedItem="{Binding KvCacheType}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Warm-tier rebalancing" Classes="label" />
                                <ComboBox ItemsSource="{Binding RebalanceOptions}" SelectedItem="{Binding RebalancePolicy}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <CheckBox Content="Per-expert VRAM cache (MoE, Phase 2)" IsChecked="{Binding ExpertCacheEnabled}"
                                      ToolTip.Tip="Keeps the hottest individual experts of every MoE layer in VRAM slots and computes the rest on the CPU. Needs the patched llama.cpp (native/llama.cpp-hbec)." />
                            <TextBlock Text="{Binding ExpertCacheNote}" Classes="muted" TextWrapping="Wrap" Margin="26,2,0,0" />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*,12,*" Margin="0,0,0,12">
                            <CheckBox Grid.Column="0" Content="Learn expert routing (MoE)" IsChecked="{Binding RoutingProfilerEnabled}"
                                      VerticalAlignment="Bottom" Margin="0,0,12,0"
                                      ToolTip.Tip="While idle, replays recent chat tokens through a side context and records which experts the router picks." />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Profiler window (tokens)" Classes="label" />
                                <TextBox Text="{Binding ProfilerWindowTokens}" IsEnabled="{Binding RoutingProfilerEnabled}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Rebalance threshold (% hit-rate gain)" Classes="label" />
                                <TextBox Text="{Binding RebalanceThresholdPct}" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Text="Plan preview (uses the context/batch settings above)" Classes="label" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="↻ Recalculate" Classes="ghost" Padding="8,3"
                                            Command="{Binding RefreshPreviewCommand}" />
                                </Grid>
                                <ContentControl Content="{Binding TierPreview}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <views:TierBreakdownView />
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                                <TextBlock Text="{Binding TierStatus}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding RuntimeStatus}" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding HasRebalanceSuggestion}" Margin="0,6,0,0">
                        <TextBlock Text="{Binding RebalanceSuggestion}" Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="480" />
                        <Button Content="Apply" Classes="accent" Padding="10,4" Margin="10,0,0,0"
                                Command="{Binding ApplyRebalanceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="💾 Save"
                        Classes="accent"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,8,0" />
                <Button Content="↺ Reset Defaults"
                        Classes="ghost"
                        Command="{Binding ResetDefaultsCommand}" />
                <TextBlock Text="{Binding SaveStatus}"
                           Foreground="{StaticResource SuccessBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
